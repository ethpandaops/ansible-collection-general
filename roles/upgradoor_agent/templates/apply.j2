{#- Directives of files/apply.sh, in order; carries the host key. -#}
{% set rel = upgradoor_agent_release | default(none) %}
{% if upgradoor_agent_binary_local_path | length == 0 %}
{% if rel is mapping
      and rel.verified | default(false) is sameas true
      and rel == upgradoor_agent_rv_verified | default({})
      and rel.version | default('') == upgradoor_agent_version
      and rel.manifest_url | default('') == upgradoor_agent_manifest_url
      and upgradoor_agent_arch in rel.binaries | default({}) %}
release {{ [upgradoor_agent_version, rel.seq | int, rel.binaries[upgradoor_agent_arch], upgradoor_agent_arch, upgradoor_agent_binary_url,
            upgradoor_agent_install_dir, upgradoor_agent_binary_path, upgradoor_agent_release_seq_file,
            upgradoor_agent_allow_downgrade | bool | int, ansible_facts.python.executable | default('/usr/bin/python3')] | join(' ') }}
{% else %}
fail {{ ('no verified release of upgradoor ' ~ upgradoor_agent_version ~ ' from ' ~ upgradoor_agent_manifest_url
         ~ ' with a host binary for linux-' ~ upgradoor_agent_arch ~ ' (it lists '
         ~ ((rel.binaries | default({}) if rel is mapping else {}) | list | map('regex_replace', '^', 'linux-') | join(', ') or 'none')
         ~ '); upgradoor_agent_release is an output of the role and must never be set.') | b64encode }}
{% endif %}
{% endif %}
group {{ upgradoor_agent_group }}
group {{ upgradoor_agent_docker_group }}
user {{ upgradoor_agent_user }} {{ upgradoor_agent_group }} {{ upgradoor_agent_docker_group }} {{ upgradoor_agent_state_dir }} /usr/sbin/nologin
member {{ upgradoor_agent_entry_user }} {{ upgradoor_agent_group }}
dir {{ upgradoor_agent_config_dir }} root root 0755
dir {{ upgradoor_agent_lib_dir }} root root 0755
dir {{ upgradoor_agent_state_dir }} {{ upgradoor_agent_user }} {{ upgradoor_agent_group }} 0700
{# setgid: files created by either side get the group. #}
dir {{ upgradoor_agent_overrides_dir }} {{ upgradoor_agent_user }} {{ upgradoor_agent_group }} 2775
file {{ upgradoor_agent_upgrade_script }} root root 0755 - {{ lookup('ansible.builtin.template', 'upgrade-packages.sh.j2') | b64encode }}
file {{ upgradoor_agent_sudoers_file }} root root 0440 visudo {{ lookup('ansible.builtin.template', 'sudoers.j2') | b64encode }}
file {{ upgradoor_agent_key_file }} {{ upgradoor_agent_user }} {{ upgradoor_agent_group }} 0600 restart {{ upgradoor_agent_host_files[upgradoor_agent_hostname].key | b64encode }}
file {{ upgradoor_agent_cert_file }} {{ upgradoor_agent_user }} {{ upgradoor_agent_group }} 0600 restart {{ upgradoor_agent_host_files[upgradoor_agent_hostname].cert | b64encode }}
file {{ upgradoor_agent_config_file }} root root 0644 restart {{ lookup('ansible.builtin.template', 'agent.yaml.j2') | b64encode }}
file /etc/systemd/system/{{ upgradoor_agent_service_name }}.service root root 0644 restart,reload {{ lookup('ansible.builtin.template', 'upgradoor-agent.service.j2') | b64encode }}
{% if upgradoor_agent_registry_auth_source | length > 0 %}
copy {{ upgradoor_agent_registry_auth_source }} {{ upgradoor_agent_registry_auth_file }} {{ upgradoor_agent_user }} {{ upgradoor_agent_group }} 0600
{% endif %}
{% if upgradoor_agent_validators_marker_file | length > 0 %}
{# The marker is world-readable, the directory around it is not: pass through it only. #}
acl {{ upgradoor_agent_validators_marker_file }} {{ upgradoor_agent_user }}
{% endif %}
overrides {{ upgradoor_agent_overrides_file }} {{ upgradoor_agent_overrides_link or '-' }} {{ upgradoor_agent_entry_user }} {{ upgradoor_agent_user }} {{ upgradoor_agent_group }}
service {{ upgradoor_agent_service_name }} {{ upgradoor_agent_service_enabled | bool | int }} {{ upgradoor_agent_service_state }}
{% if upgradoor_agent_service_state != 'stopped' %}
init {{ upgradoor_agent_binary_path }} {{ upgradoor_agent_overrides_file }} {{ upgradoor_agent_socket_path }}
{% endif %}
