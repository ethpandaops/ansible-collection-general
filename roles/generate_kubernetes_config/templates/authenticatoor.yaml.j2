# {{ ansible_managed }}

authenticatoor:
  fullnameOverride: authenticatoor

  image:
    repository: {{ default_tooling_images.authenticatoor.split(':') | first }}
    tag: {{ default_tooling_images.authenticatoor.split(':') | last }}
    pullPolicy: {% if "latest" in (default_tooling_images.authenticatoor.split(':') | last) %}Always{% else %}IfNotPresent{% endif %}

  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi

  issuer: "https://auth.{{ network_subdomain }}"
{% if gen_kubernetes_config_network_alias_subdomains %}
  # Logins must be allowed to return to the alias hosts too. Setting this
  # replaces the chart default of "*.<issuer parent zone>", so list that as well.
  allowedReturnHosts:
{% for _sub in gen_kubernetes_config_network_subdomains %}
    - "*.{{ _sub }}"
{% endfor %}
{% endif %}

{% if gen_kubernetes_config_authenticatoor_bearer_issuer_url %}
  # Browsers keep logging in through Cloudflare Access; the bearer provider
  # serves non-interactive clients at /authentik/token (outside the CF-covered
  # /auth/*) and is not offered on the login page.
  authMode:
    - cfaccess
  providers:
    - name: cfaccess
      type: cloudflare
      cloudflareAccess:
        teamDomain: "{{ gen_kubernetes_config_authenticatoor_cf_team_domain }}"
        audTag: "{{ gen_kubernetes_config_authenticatoor_cf_aud_tag }}"
    - name: authentik
      type: bearer
      bearer:
        issuerURL: "{{ gen_kubernetes_config_authenticatoor_bearer_issuer_url }}"
        audiences: {{ gen_kubernetes_config_authenticatoor_bearer_audiences | to_json }}
{% else %}
  cloudflareAccess:
    verifyJWT: true
    teamDomain: "{{ gen_kubernetes_config_authenticatoor_cf_team_domain }}"
    audTag: "{{ gen_kubernetes_config_authenticatoor_cf_aud_tag }}"
{% endif %}

  persistence:
    enabled: true
    size: "{{ gen_kubernetes_config_authenticatoor_persistence_size }}"

  ingress:
    enabled: true
    className: ingress-nginx-public
    hosts:
{% for _sub in gen_kubernetes_config_network_subdomains %}
      - host: auth.{{ _sub }}
        paths:
          - path: /
            pathType: Prefix
{% endfor %}
