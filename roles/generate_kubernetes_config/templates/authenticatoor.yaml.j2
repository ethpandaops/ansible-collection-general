# {{ ansible_managed }}

authenticatoor:
  fullnameOverride: authenticatoor

  image:
    repository: {{ default_tooling_images.authenticatoor.split(':') | first }}
    tag: {{ default_tooling_images.authenticatoor.split(':') | last }}
    pullPolicy: {% if "latest" in (default_tooling_images.authenticatoor.split(':') | last) %}Always{% else %}IfNotPresent{% endif %}

  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi

  issuer: "https://auth.{{ network_subdomain }}"
{% if gen_kubernetes_config_network_alias_subdomains %}
  # Logins must be allowed to return to the alias hosts too. Setting this
  # replaces the chart default of "*.<issuer parent zone>", so list that as well.
  allowedReturnHosts:
{% for _sub in gen_kubernetes_config_network_subdomains %}
    - "*.{{ _sub }}"
{% endfor %}
{% endif %}

  authMode: [authentik, cfaccess]
  providers:
    - name: authentik
      type: oidc
      oidc:
        issuerURL: "https://authentik.analytics.production.platform.ethpandaops.io/application/o/authenticatoor/"
        callbackURL: "https://auth.{{ network_subdomain }}/authentik/callback"
        clientId: "authenticatoor"
        clientSecretFile: "/etc/authenticatoor/secrets/oidc-client-secret"
        # A group "team:<name>" of the IdP becomes the team <name>.
        teamRules:
          - claim: groups
            prefix: "team:"
    - name: cfaccess
      type: cloudflare
      cloudflareAccess:
        verifyJWT: true
        teamDomain: "{{ gen_kubernetes_config_authenticatoor_cf_team_domain }}"
        audTag: "{{ gen_kubernetes_config_authenticatoor_cf_aud_tag }}"

  providerSecrets:
    files:
      oidc-client-secret: "<path:/secrets/services/services.enc.yaml#authenticatoor | jsonPath {.oidc_client_secret}>"
{% if gen_kubernetes_config_authenticatoor_grants is not none %}

  grants:
    {{ gen_kubernetes_config_authenticatoor_grants | to_nice_yaml(indent=2, width=4096) | indent(4) | trim }}
{% endif %}

  persistence:
    enabled: true
    size: "{{ gen_kubernetes_config_authenticatoor_persistence_size }}"

  ingress:
    enabled: true
    className: ingress-nginx-public
    hosts:
{% for _sub in gen_kubernetes_config_network_subdomains %}
      - host: auth.{{ _sub }}
        paths:
          - path: /
            pathType: Prefix
{% endfor %}
