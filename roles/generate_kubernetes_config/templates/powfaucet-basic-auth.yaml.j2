{# Written to the faucet chart's templates/ (ingressBasicAuth on a Traefik
   class): the faucet's own basic-auth gate, beside it in its namespace. Its
   Ingress uses it as <namespace>-basic-auth@kubernetescrd
   (gen_kubernetes_config_ingress_basic_auth_middleware); the class's admission
   policy allows exactly this Middleware in a devnet namespace. The user is the
   repo's node_ingress user, which only the panda proxy holds. Empty otherwise. #}
{% if (gen_kubernetes_config_ingress_traefik | bool) and (item.value.faucetOverride.ingressBasicAuth | default(false)) %}
# {{ ansible_managed }}
apiVersion: v1
kind: Secret
metadata:
  name: basic-auth
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
type: kubernetes.io/basic-auth
stringData:
  username: "<path:{{ gen_kubernetes_config_class_secrets_file }}#ethereum | jsonPath {.testnets.{{ devnet_name }}-devnets.node_ingress.username}>"
  password: "<path:{{ gen_kubernetes_config_class_secrets_file }}#ethereum | jsonPath {.testnets.{{ devnet_name }}-devnets.node_ingress.password}>"
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: basic-auth
  labels:
    ethpandaops.io/traefik-public: "true"
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  basicAuth:
    secret: basic-auth
    realm: Authentication Required
{% endif %}
