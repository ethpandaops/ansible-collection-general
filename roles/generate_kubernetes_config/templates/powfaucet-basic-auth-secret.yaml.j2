# {{ ansible_managed }}
{% set _ingress_auth_secret = item.value.faucetOverride.ingressAuthSecret | default('') %}
{% if _ingress_auth_secret %}
{% set _vault_path = '/secrets/services/services.enc.yaml#ethereum | jsonPath {.testnets.' + devnet_name + '-devnets.node_ingress.' %}
{% set _srv_user = '<path:' + _vault_path + 'username}>' %}
{% set _srv_password = '<path:' + _vault_path + 'password}>' %}
apiVersion: v1
kind: Secret
metadata:
  name: {{ _ingress_auth_secret }}
type: Opaque
stringData:
  # htpasswd file for the ingress' basic auth. nginx accepts the {PLAIN} scheme,
  # so the srv credential resolves from vault at sync time and no hash is
  # committed.
  auth: "{{ _srv_user }}:{PLAIN}{{ _srv_password }}"
{% endif %}
